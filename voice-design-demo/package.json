{
  "name": "voice-design-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "if ls .env* 2>/dev/null | grep -qv '^.env.example$'; then echo 'Refusing to deploy: OpenNext would bundle .env* keys into the public Worker. Remove them first.' >&2; exit 1; fi && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["esbuild", "sharp", "unrs-resolver", "workerd"]
}
